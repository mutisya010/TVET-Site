# ==============================================================================
# Loima TVC (TVET Site) - Production Environment Configuration Template
# ==============================================================================
# Copy this file to /etc/tvet-site/tvet.env on your Linux VPS.
# Ensure file permissions are restricted: chmod 600 /etc/tvet-site/tvet.env
# ==============================================================================

# Core Django Settings
DJANGO_ENV="production"
DJANGO_DEBUG="False"
SECRET_KEY="generate-a-long-random-secret-key-for-production"

# Host & Domain Configuration
DOMAIN="loima-tvc.ac.ke"
ALLOWED_HOSTS="loima-tvc.ac.ke,www.loima-tvc.ac.ke,loima.royalsoftwares.co.ke,www.loima.royalsoftwares.co.ke,loimatvc.ac.ke,www.loimatvc.ac.ke,127.0.0.1,localhost"
CORS_ORIGIN="https://loima-tvc.ac.ke,https://www.loima-tvc.ac.ke,https://loima.royalsoftwares.co.ke,https://www.loima.royalsoftwares.co.ke"
CSRF_TRUSTED_ORIGINS="https://loima-tvc.ac.ke,https://www.loima-tvc.ac.ke,https://loima.royalsoftwares.co.ke,https://www.loima.royalsoftwares.co.ke"

# Database Configuration (PostgreSQL recommended for Linux VPS)
# Leave DB_ENGINE as postgresql to use local or remote PostgreSQL instance.
# To fall back to SQLite, leave DB_ENGINE as "django.db.backends.sqlite3" and leave DB_NAME empty.
DB_ENGINE="django.db.backends.postgresql"
DB_NAME="loimadb"
DB_USER="postgres"
DB_PASSWORD="Admin@2025"
DB_HOST="127.0.0.1"
DB_PORT="5433"

# Static & Media Storage Paths on VPS
STATIC_ROOT="/var/www/tvet-site-static"
MEDIA_ROOT="/var/www/tvet-site-media"

# Maintenance Mode Configuration
# Secret key used to bypass maintenance mode via private link (?preview_key=...)
MAINTENANCE_BYPASS_KEY="tvet-preview-2026"
